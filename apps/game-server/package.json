  "dependencies": {
    "@deathmatch/shared": "0.1.0",
    "@colyseus/core": "0.18.27",
    "@colyseus/ws-transport": "0.18.4",
    "@supabase/supabase-js": "^2.80.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5"
  }
}
